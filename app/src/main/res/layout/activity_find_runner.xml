<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Map View -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Map showing the locations of available runners" />

    <!-- Finding Runners Text -->
    <TextView
        android:id="@+id/tvFindingRunners"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Finding available runners..."
        android:textSize="18sp"
        android:layout_centerInParent="true"
        android:background="#AAFFFFFF"
        android:padding="12dp"
        android:visibility="visible" />

    <!-- Runner Details Section -->
    <LinearLayout
        android:id="@+id/runnerDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="#AAFFFFFF"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Runner Name -->
        <TextView
            android:id="@+id/tvRunnerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Runner Name:"
            android:textSize="16sp"
            android:fontFamily="@font/mustica"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Runner Phone -->
        <TextView
            android:id="@+id/tvRunnerPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number:"
            android:textSize="16sp"
            android:fontFamily="@font/mustica"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Runner Vehicle Number -->
        <TextView
            android:id="@+id/tvRunnerVehicleNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Number:"
            android:textSize="16sp"
            android:fontFamily="@font/mustica"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Runner Vehicle Type -->
        <TextView
            android:id="@+id/tvRunnerVehicleType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vehicle Type:"
            android:textSize="16sp"
            android:fontFamily="@font/mustica"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />

        <!-- Total Price -->
        <TextView
            android:id="@+id/tvTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Price:"
            android:fontFamily="@font/mustica"
            android:textSize="16sp"
            android:textColor="#000000"
            android:layout_marginBottom="8dp" />
    </LinearLayout>
</RelativeLayout>
