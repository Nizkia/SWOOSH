<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/GreyBlue"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Pickup Details Section -->
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pickup Details"
        android:fontFamily="@font/made_tommy_eb"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Customer Name Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

    <TextView
            android:id="@+id/tvCustomerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer: "
            android:layout_marginBottom="8dp"
            android:textSize="16sp"
        android:fontFamily="@font/mustica"/>
    </LinearLayout>
    </androidx.cardview.widget.CardView>



        <!-- No. of Items Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
    <TextView
            android:id="@+id/tvNoOfItems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No. of Items: "
            android:layout_marginBottom="16dp"
            android:textSize="16sp"
        android:fontFamily="@font/mustica"/>
    </LinearLayout>
    </androidx.cardview.widget.CardView>

        <!-- Order Details Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Details"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/made_tommy_eb"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvParcelInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Information"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/mustica"/>

        <TextView
            android:id="@+id/tvPaymentInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payment Info"
            android:fontFamily="@font/mustica"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <!-- Current Status Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Status"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/mustica"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCurrentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status Information"
            android:fontFamily="@font/mustica"
            android:layout_marginBottom="16dp" />

        <!-- Update Status Button -->
        <Button
            android:id="@+id/btnUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Update Status"
            android:backgroundTint="#596e81"
            android:fontFamily="@font/mustica"
            android:layout_marginBottom="16dp" />

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="#8a99a9"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
